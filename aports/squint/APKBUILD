# Contributor: André Biseth <andre@biseth.net>
# Maintainer: André Biseth <andre@biseth.net>
#
# squint, the text editor for files too big for text editors, as the Full
# tier's default editor: a proof of concept, pinned to a release of
#   https://github.com/bisand/squint
pkgname=squint
# squint's own version, from the release this is built from. It keeps its
# numbering here (ADR 0008): nothing in this workspace decides it, so neither
# the release version nor the build number is stamped onto it. Moving to a new
# squint is this line and its sha512 below.
pkgver=0.1.8
pkgrel=0
pkgdesc="Text editor that opens files of any size instantly"
url="https://github.com/bisand/squint"
arch="aarch64 x86_64"
license="MIT"
# One window drawn by DeniseUI through winit, on the GPU where it can and in
# software where it cannot. rfd's open and save dialogs are GTK 3's.
makedepends="cargo gtk+3.0-dev libxkbcommon-dev"
depends="font-fira-code-nerd"
# !check: the test suite runs in squint's own CI
# net: cargo fetches the crates
options="!check net"
source="
	$url/archive/v$pkgver/$pkgname-$pkgver.tar.gz
	squint.desktop
	"
builddir="$srcdir/$pkgname-$pkgver"

# squint's release workflow stamps the version into desktop/Cargo.toml before
# it builds, so the repository keeps 0.1.0 and only the released binaries carry
# the release's number. Without the same step here, squint would report 0.1.0
# from a package called 0.1.8. The lock file is stamped with it so --locked
# still holds; squint-core is a path dependency with no version to match, so
# only squint's own two entries move.
prepare() {
	default_prepare
	local f
	for f in desktop/Cargo.toml Cargo.lock; do
		sed -i '/^name = "squint"$/{n;s/^version = .*/version = "'"$pkgver"'"/;}' "$f"
		grep -A1 '^name = "squint"$' "$f" | grep -q "^version = \"$pkgver\"$" \
			|| die "could not stamp $pkgver into $f"
	done
}

build() {
	cargo build --release --locked -p squint
}

package() {
	install -Dm755 target/release/squint "$pkgdir"/usr/bin/squint
	install -Dm644 "$srcdir"/squint.desktop \
		"$pkgdir"/usr/share/applications/squint.desktop
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

# The pin. build-packages.sh leaves these alone rather than running
# `abuild checksum` over them, so a tarball that is not the one this was
# written against fails the build.
sha512sums="
bccea238d028667abd833a6462a54bd951e65d98406266b7717ab03ce69ac4f5dd6d802cf6f62561725572ae2a697f99055f1ab68ecfbe66fce1c9b6489a1c9d  squint-0.1.8.tar.gz
280fce6ff3b4b7a73443795fead1da57d4650b5659ac6830df5c5c0d055cec09eb0dd90166b8ba64339b1544475e5253e2d97defc886c387d281e95928f98e1a  squint.desktop
"
