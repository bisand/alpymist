# Contributor: André Biseth <andre@biseth.net>
# Maintainer: André Biseth <andre@biseth.net>
pkgname=alpymist-store
pkgver=0.0.7
pkgrel=0
pkgdesc="Alpymist Store: Flathub applications and Alpine packages, searched and installed from one window"
url="https://github.com/bisand/alpymist"
arch="all"
license="MIT OR Apache-2.0"
# The catalogues are read from what flatpak and apk already keep on disk, so
# nothing is linked for them: the window is an xdg toplevel over wl_shm, drawn
# by Denise on the CPU like the menu, which needs libxkbcommon and the same
# fonts. Flatpak installs per user through the flatpak command; apk changes go
# through pkexec to alpymist-store-helper, which takes four verbs and package
# names and nothing else. polkit asks an administrator's password for them in
# alpymist-auth's dialog, and keeps the answer a few minutes except for
# removals. logger is busybox's, for the helper's log.
makedepends="cargo libxkbcommon-dev"
depends="alpymist-auth flatpak font-fira-ttf font-nerd-fonts-symbols polkit"
options="!check"  # the test suite runs in CI, not in the package build
source=""
builddir="$srcdir"

prepare() {
	# Same as alpymist: the workspace is bind-mounted at /src.
	tar -C /src -cf - \
		--exclude=./target \
		--exclude=./out \
		--exclude=./.git \
		. | tar -C "$builddir" -xf -
}

build() {
	cd "$builddir"
	cargo build --release --locked -p alpymist-store --bins
}

package() {
	install -Dm755 "$builddir"/target/release/alpymist-store \
		"$pkgdir"/usr/bin/alpymist-store
	install -Dm755 "$builddir"/target/release/alpymist-store-helper \
		"$pkgdir"/usr/libexec/alpymist-store-helper
	install -Dm644 "$builddir"/desktop/polkit/org.alpymist.store.policy \
		"$pkgdir"/usr/share/polkit-1/actions/org.alpymist.store.policy
	# In the applications menu, and what a downloaded .flatpakref opens with.
	install -Dm644 "$builddir"/desktop/store/alpymist-store.desktop \
		"$pkgdir"/usr/share/applications/alpymist-store.desktop
}

# Filled in by `abuild checksum` at build time; see alpymist-install.
sha512sums=""
