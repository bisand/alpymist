# Contributor: André Biseth <andre@biseth.net>
# Maintainer: André Biseth <andre@biseth.net>
pkgname=alpymist-splash
pkgver=0.0.7
pkgrel=0
pkgdesc="Alpymist boot splash, drawn straight to DRM/KMS"
url="https://github.com/bisand/alpymist"
arch="all"
license="MIT OR Apache-2.0"
makedepends="cargo"
# The font is a runtime suggestion: without it the splash falls back to
# Denise's built-in bitmap and still reads correctly.
depends="font-fira-ttf"
subpackages="$pkgname-openrc $pkgname-boot:boot:noarch"
options="!check"  # the test suite runs in CI, not in the package build
source="alpymist-splash.initd alpymist-splash-done.initd"
builddir="$srcdir"

prepare() {
	# Same as alpymist: the workspace is bind-mounted at /src.
	tar -C /src -cf - \
		--exclude=./target \
		--exclude=./out \
		--exclude=./.git \
		. | tar -C "$builddir" -xf -
}

build() {
	cd "$builddir"
	# No default features: the desktop window backend must not be linked into
	# something that runs this early in boot.
	cargo build --release --locked \
		-p alpymist-splash --no-default-features --features drm
	# The boot menus' backgrounds, drawn by the same code as the splash they
	# hand over to, so the machine shows one continuous picture from the
	# bootloader onwards. Two sizes because syslinux draws at a fixed 640x480
	# VESA mode and GRUB stretches to the panel, and two formats because
	# Alpine's grub-efi for arm64 ships no PNG decoder at all; see
	# write_image in alpymist-wallpaper.
	cargo build --release --locked -p alpymist-wallpaper
	./target/release/alpymist-wallpaper --boot menu-640.png 640 480
	./target/release/alpymist-wallpaper --boot menu-1280.jpg 1280 800
}

package() {
	install -Dm755 "$builddir"/target/release/alpymist-splash \
		"$pkgdir"/usr/bin/alpymist-splash
	install -Dm755 "$srcdir"/alpymist-splash.initd \
		"$pkgdir"/etc/init.d/alpymist-splash
	install -Dm755 "$srcdir"/alpymist-splash-done.initd \
		"$pkgdir"/etc/init.d/alpymist-splash-done
}

boot() {
	pkgdesc="Alpymist boot menu backgrounds"
	depends=""
	# Deliberately depended on by nothing. It exists so the image build can
	# take the art out of a signed package with `apk fetch`, rather than
	# carrying a PNG in the repository that could drift from the code that
	# draws it; see profiles/mkimg.alpymist.sh. Installing it on a machine
	# would only waste the space.
	install -Dm644 "$builddir"/menu-640.png \
		"$subpkgdir"/usr/share/alpymist/boot/menu-640.png
	install -Dm644 "$builddir"/menu-1280.jpg \
		"$subpkgdir"/usr/share/alpymist/boot/menu-1280.jpg
}

# Filled in by `abuild checksum` at build time; see alpymist-install.
sha512sums=""
