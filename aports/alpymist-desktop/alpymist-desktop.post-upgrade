#!/bin/sh
# Hyprland's keyboard layout: the US default, where the installer or the user
# has not already written one. See package() in the APKBUILD for why the file in
# /etc is not the package's own.
conf=/etc/alpymist/hyprland-keyboard.conf
if [ ! -e "$conf" ]; then
	mkdir -p /etc/alpymist
	cp /usr/share/alpymist/hyprland-keyboard.conf "$conf"
fi

# Ghostty is no longer part of the Full tier, and this upgrade removes it. Each
# account's hyprland.conf is its own and is not changed here, so say which ones
# still start it on Super+Return and Super+Q.
for home in /root /home/*; do
	hypr="$home/.config/hypr/hyprland.conf"
	if [ -f "$hypr" ] && grep -Eq '^\$terminal *= *ghostty' "$hypr"; then
		echo "  * $hypr starts ghostty, which is no longer installed."
		echo "    Change its \$terminal line to: \$terminal = foot"
	fi
done
# The screensaver and the screen turning off are started from hyprland.conf,
# which belongs to the account and is not changed here. Accounts made before
# this release have no such line, so their screen would go on burning: say so,
# and say the line, rather than leaving it silently absent.
for home in /root /home/*; do
	hypr="$home/.config/hypr/hyprland.conf"
	if [ -f "$hypr" ] && ! grep -q 'alpymist-screensaver idle' "$hypr"; then
		echo "  * $hypr does not start the screensaver or turn the screen off."
		echo "    Add this line beside the other exec-once lines:"
		echo "        exec-once = alpymist-screensaver idle"
	fi
done

# Hyprland sources ~/.config/alpymist/hypr/settings.conf and refuses a missing
# one. `alpymist session hyprland` writes it at login; for accounts already
# logged in, whose Hyprland reloads when this package's files change, write it
# now, as each account.
if command -v alpymist >/dev/null 2>&1; then
	for home in /home/*; do
		[ -d "$home/.config/hypr" ] || continue
		owner=$(stat -c %U "$home" 2>/dev/null) || continue
		[ "$owner" = root ] && continue
		su -s /bin/sh "$owner" -c "alpymist session prepare" >/dev/null 2>&1 || true
	done
fi

# greetd's configuration for the desktop was alpymist-full.toml while there
# were tiers, and is alpymist.toml now there is one; the old file goes with
# the old package. Point greetd at the new one where the line is still exactly
# what the installer wrote, before the next boot looks for it.
conf=/etc/conf.d/greetd
if [ -f "$conf" ]; then
	sed -i 's|^cfgfile="/etc/greetd/alpymist-full.toml"$|cfgfile="/etc/greetd/alpymist.toml"|' "$conf"
fi

# The desktop opens its screen and keyboard through seatd, and the login screen
# does not, so greetd has to wait for seatd or a boot that never starts it
# shows a login screen that every login falls straight back to. The installer
# now writes this; add it where an earlier installer's file lacks it.
if [ -f "$conf" ] && grep -q '^cfgfile=.*alpymist\.toml' "$conf" &&
	! grep -q '^rc_need=' "$conf"; then
	printf '# The desktop opens its screen and keyboard through seatd.\nrc_need="seatd"\n' >>"$conf"
fi
exit 0
