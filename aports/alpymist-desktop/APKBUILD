# Contributor: André Biseth <andre@biseth.net>
# Maintainer: André Biseth <andre@biseth.net>
#
# The Alpymist desktop: which Alpine packages make up each tier, and the
# configuration that makes them look and behave as one system. The only thing
# compiled is the wallpaper, rendered by the same code that draws the splash
# and installer. Configuration lives in the repository under desktop/.
#
# User-facing configuration is installed to /etc/skel, which adduser copies into
# the new account: it becomes the user's own to change, as on Omarchy, rather
# than system files an upgrade would overwrite.
pkgname=alpymist-desktop
pkgver=0.0.6
pkgrel=0
pkgdesc="Alpymist desktop: what every tier shares"
url="https://github.com/bisand/alpymist"
arch="noarch"
license="MIT OR Apache-2.0"
# greetd on VT 7, with alpymist-greeter as the login screen; seatd hands the
# compositor its devices without running it as root; pam-rundir gives each login the
# XDG_RUNTIME_DIR a Wayland compositor refuses to start without, which on
# Alpine elogind would otherwise provide; pipewire for sound; flatpak is how
# applications are installed (ADR 0001), and the GTK portal is what lets those
# sandboxed apps open and save files; alpymist-keys lets apk trust the Alpymist
# repository the installer adds, and alpymist switches it between stable and
# dev (ADR 0006). LibreWolf is the browser: Firefox with the
# tracking and telemetry taken out, built for musl and kept patched by Alpine.
# Wi-Fi is iwd; the installer adds the account to netdev, which iwd lets manage
# networks. On the Wayland tiers alpymist-wifi is the bar's icon and popup;
# impala stays for a terminal, and for the Legacy tier, which has neither.
# Terminals use FiraCode Nerd Font: Fira Code's ligatures, with the prompt's
# icons at the size and place they were made for, which a separate symbols
# font gets wrong.
depends="
	adwaita-icon-theme
	alpymist-greeter
	alpymist-keys
	alpymist-shell=$pkgver-r$pkgrel
	alpymist-splash-openrc
	alpymist
	brightnessctl
	dbus
	flatpak
	breeze-cursors
	font-dejavu
	font-fira-code-nerd
	font-fira-ttf
	font-nerd-fonts-symbols
	gsettings-desktop-schemas
	greetd
	impala
	iwd
	librewolf
	mesa-dri-gallium
	pam-rundir
	pipewire
	pipewire-pulse
	polkit
	seatd
	wireplumber
	xdg-desktop-portal
	xdg-desktop-portal-gtk
	xdg-user-dirs
	"
makedepends="cargo"
subpackages="
	alpymist-shell:_shell
	$pkgname-wayland:_wayland
	$pkgname-full:_full
	$pkgname-lite:_lite
	$pkgname-legacy:_legacy
	"
options="!check"  # the test suite runs in CI, not in the package build
install="$pkgname-full.post-install $pkgname-full.post-upgrade"
source=""
builddir="$srcdir"

prepare() {
	# Same as alpymist: the workspace is bind-mounted at /src.
	tar -C /src -cf - \
		--exclude=./target \
		--exclude=./out \
		--exclude=./.git \
		. | tar -C "$builddir" -xf -
}

build() {
	cargo build --release --locked -p alpymist-wallpaper
	# The wallpaper and the mark come from the same code: the furthest range in
	# the wallpaper is the mark, weathered.
	./target/release/alpymist-wallpaper "$builddir"/alpymist.png 2560 1440
	./target/release/alpymist-wallpaper --mark "$builddir"/mark.png 64
}

# Copy one of desktop/skel's parts into a package's /etc/skel.
_skel() {
	mkdir -p "$2"/etc/skel
	cp -a "$builddir"/desktop/skel/"$1"/. "$2"/etc/skel/
}

package() {
	install -Dm644 "$builddir"/alpymist.png \
		"$pkgdir"/usr/share/backgrounds/alpymist/alpymist.png
	install -Dm644 "$builddir"/mark.png "$pkgdir"/usr/share/alpymist/mark.png
	# A PAM service of our own rather than an edit to greetd's, which belongs
	# to the greetd package; each tier's configuration names it.
	install -Dm644 "$builddir"/desktop/alpymist-greetd.pam \
		"$pkgdir"/etc/pam.d/alpymist-greetd
	install -Dm644 "$builddir"/desktop/mimeapps.list "$pkgdir"/etc/xdg/mimeapps.list
	# A desktop started from a text console, where there is no PAM to make
	# XDG_RUNTIME_DIR; see the script.
	install -Dm644 "$builddir"/desktop/profile/alpymist-runtime-dir.sh \
		"$pkgdir"/etc/profile.d/alpymist-runtime-dir.sh
	# Dark by default, for GTK 3, GTK 4, libadwaita and whatever asks the
	# portal. Defaults a user's own settings override; glib's trigger compiles
	# the schema override when this is installed.
	install -Dm644 "$builddir"/desktop/theme/90_alpymist.gschema.override \
		"$pkgdir"/usr/share/glib-2.0/schemas/90_alpymist.gschema.override
	install -Dm644 "$builddir"/desktop/theme/gtk-3.0-settings.ini \
		"$pkgdir"/etc/xdg/gtk-3.0/settings.ini
	install -Dm644 "$builddir"/desktop/theme/gtk-4.0-settings.ini \
		"$pkgdir"/etc/xdg/gtk-4.0/settings.ini
	install -Dm644 "$builddir"/desktop/librewolf/alpymist.js \
		"$pkgdir"/usr/lib/librewolf/defaults/pref/alpymist.js
	install -Dm644 "$builddir"/desktop/xdg-desktop-portal/portals.conf \
		"$pkgdir"/etc/xdg/xdg-desktop-portal/portals.conf
	# Flathub's remote, which each account adds for itself at login.
	install -Dm644 "$builddir"/desktop/flatpak/flathub.flatpakrepo \
		"$pkgdir"/usr/share/alpymist/flathub.flatpakrepo
	install -d "$pkgdir"/etc/alpymist
	_skel common "$pkgdir"
}

# zsh with oh-my-zsh, the two plugins most people add first, and starship. In
# the image's world rather than the desktop's, because adduser makes zsh the
# login shell: it must be installed even if the desktop is not.
_shell() {
	pkgdesc="Alpymist shell: zsh, oh-my-zsh and starship"
	depends="
		oh-my-zsh
		starship
		zsh
		zsh-autosuggestions
		zsh-completions
		zsh-syntax-highlighting
		"
	_skel shell "$subpkgdir"
}

# The Wayland tools the Full and Lite tiers share. Hyprland's own wallpaper,
# lock and idle daemons are not packaged for Alpine 3.24; the sway ones work
# under any wlroots-style compositor, Hyprland included.
_wayland() {
	pkgdesc="Alpymist desktop: tools shared by the Wayland tiers"
	# alpymist-wifi and alpymist-power are the bar's Wi-Fi and battery icons
	# and popups under both compositors, and alpymist-power what the lid and
	# the power button do. alpymist-store is where software is installed from,
	# alpymist-about says which Alpymist is running, and alpymist-settings is
	# where settings are changed. alpymist-screensaver is what an idle machine
	# shows and, through swayidle, when its screen goes off; it brings swayidle
	# and wlopm with it, so neither is named here.
	depends="
		$pkgname=$pkgver-r$pkgrel
		alpymist-about
		alpymist-settings
		alpymist-power
		alpymist-screensaver
		alpymist-store
		alpymist-wifi
		foot
		fuzzel
		grim
		mako
		pavucontrol
		slurp
		swaybg
		swaylock
		waybar
		wl-clipboard
		xdg-desktop-portal-wlr
		"
	# The bar itself, which each account's ~/.config/waybar includes, so an
	# upgrade reaches accounts made before it.
	local conf
	for conf in modules.jsonc hyprland.jsonc labwc.jsonc style.css; do
		install -Dm644 "$builddir"/desktop/waybar/$conf \
			"$subpkgdir"/usr/share/alpymist/waybar/$conf
	done
	for conf in hyprland labwc; do
		install -Dm644 "$builddir"/desktop/xdg-desktop-portal/$conf-portals.conf \
			"$subpkgdir"/etc/xdg/xdg-desktop-portal/$conf-portals.conf
	done
	_skel wayland "$subpkgdir"
}

_full() {
	pkgdesc="Alpymist desktop, Full tier: Hyprland"
	# The terminal is foot, from the Wayland tools, as on the other tiers:
	# Ghostty was the terminal here once, at ten times foot's memory, and a Zig
	# build of our own to maintain. alpymist-menu is the launcher and system
	# menu hyprland.conf binds; squint is the editor, as $VISUAL and for text
	# files.
	depends="$pkgname-wayland=$pkgver-r$pkgrel alpymist-menu hyprland squint"
	install -Dm644 "$builddir"/desktop/greetd/alpymist-full.toml \
		"$subpkgdir"/etc/greetd/alpymist-full.toml
	# hyprland.conf sources /etc/alpymist/hyprland-keyboard.conf, and the
	# installer writes the chosen layout there. The package ships only the US
	# default, which its install scripts copy into /etc where there is no file
	# yet. A file of the package's own in /etc would be one the installer had
	# changed, and every upgrade would leave a .apk-new beside it.
	install -Dm644 "$builddir"/desktop/hypr/hyprland-keyboard.conf \
		"$subpkgdir"/usr/share/alpymist/hyprland-keyboard.conf
	# Permissions and Ctrl+Alt+Delete, which hyprland.conf sources; see the
	# file.
	install -Dm644 "$builddir"/desktop/hypr/hyprland-security.conf \
		"$subpkgdir"/usr/share/alpymist/hyprland-security.conf
	# Text files open in squint under Hyprland only: XDG reads
	# hyprland-mimeapps.list when XDG_CURRENT_DESKTOP is Hyprland.
	install -Dm644 "$builddir"/desktop/hypr/hyprland-mimeapps.list \
		"$subpkgdir"/etc/xdg/hyprland-mimeapps.list
	_skel full "$subpkgdir"
}

# Lite and Potato are the same packages; Potato's session only tells labwc to
# render on the CPU, so both greetd files ship here.
_lite() {
	pkgdesc="Alpymist desktop, Lite and Potato tiers: labwc"
	depends="$pkgname-wayland=$pkgver-r$pkgrel labwc"
	install -Dm644 "$builddir"/desktop/greetd/alpymist-lite.toml \
		"$subpkgdir"/etc/greetd/alpymist-lite.toml
	install -Dm644 "$builddir"/desktop/greetd/alpymist-potato.toml \
		"$subpkgdir"/etc/greetd/alpymist-potato.toml
	_skel lite "$subpkgdir"
}

# The X11 tier, made to feel like the Hyprland one: i3 with gaps, polybar as
# the top bar, rofi as the launcher, picom for rounded corners and fades.
_legacy() {
	pkgdesc="Alpymist desktop, Legacy tier: X11 with i3"
	depends="
		$pkgname=$pkgver-r$pkgrel
		dunst
		eudev
		feh
		i3lock
		i3wm
		picom
		polybar
		rofi
		setxkbmap
		xf86-input-libinput
		xinit
		xorg-server
		xrdb
		xterm
		"
	install -Dm644 "$builddir"/desktop/greetd/alpymist-legacy.toml \
		"$subpkgdir"/etc/greetd/alpymist-legacy.toml
	install -Dm644 "$builddir"/desktop/xorg/Xwrapper.config \
		"$subpkgdir"/etc/X11/Xwrapper.config
	_skel legacy "$subpkgdir"
}
