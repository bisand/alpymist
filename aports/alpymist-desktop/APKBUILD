# Contributor: André Biseth <andre@biseth.net>
# Maintainer: André Biseth <andre@biseth.net>
#
# The Alpymist desktop, which is Hyprland on Wayland (ADR 0001's addendum of
# 2026-09-27): the Alpine packages that make it up, and the configuration that
# makes them look and behave as one system. The only thing compiled is the
# drawn wallpaper, rendered by the same code that draws the installer and the
# login screen. Configuration lives in the repository under
# desktop/, and the photographs in brand/wallpapers/.
#
# User-facing configuration is installed to /etc/skel, which adduser copies into
# the new account: it becomes the user's own to change, as on Omarchy, rather
# than system files an upgrade would overwrite.
pkgname=alpymist-desktop
pkgver=0.4.0
pkgrel=0
pkgdesc="Alpymist desktop: Hyprland, and everything around it"
url="https://github.com/bisand/alpymist"
arch="noarch"
license="MIT OR Apache-2.0"
# greetd on VT 7, with alpymist-greeter as the login screen; seatd hands the
# compositor its devices without running it as root; pam-rundir gives each login the
# XDG_RUNTIME_DIR a Wayland compositor refuses to start without, which on
# Alpine elogind would otherwise provide; pipewire for sound; flatpak is how
# applications are installed (ADR 0001), and the GTK portal is what lets those
# sandboxed apps open and save files; alpymist-keys lets apk trust the Alpymist
# repository the installer adds, and alpymist switches it between stable and
# dev (ADR 0006). LibreWolf is the browser: Firefox with the
# tracking and telemetry taken out, built for musl and kept patched by Alpine.
# Wi-Fi is iwd; the installer adds the account to netdev, which iwd lets manage
# networks. alpymist-wifi is the bar's icon and popup; impala stays for a
# terminal.
# Terminals use FiraCode Nerd Font: Fira Code's ligatures, with the prompt's
# icons at the size and place they were made for, which a separate symbols
# font gets wrong. musl-locales is how musl writes dates and messages in the
# language chosen in Settings; the programs' own translations are Alpine's
# -lang packages, every language at once, and Settings installs them when asked.
# Secrets are gnome-keyring's, unlocked at login by PAM with the login
# password (Alpine's base PAM stack already calls pam_gnome_keyring where it
# is installed), and shadow's passwd, which goes through that stack, so the
# keyring's password changes with the login's; busybox's does not. SSH keys
# are OpenSSH's agent's, asked for in alpymist-auth's dialog, and git
# keeps HTTPS credentials in the keyring through git-credential-libsecret. The
# login screen has a PAM service of its own, which starts no keyring
# (ADR 0013).
# Bluetooth is bluez, with PipeWire's plugin for headphones and bluetuith to
# pair from a terminal; bluetoothd is not started at boot until Settings ›
# Bluetooth turns it on (ADR 0011).
# Beside those, the desktop itself: Hyprland; alpymist-menu, the launcher and
# system menu hyprland.conf binds; foot, the terminal; squint, the editor, as
# $VISUAL and for text files. alpymist-wifi and alpymist-power are the bar's
# Wi-Fi and battery icons and popups, and alpymist-power what the lid and the
# power button do. alpymist-store is where software is installed from,
# alpymist-about says which Alpymist is running, and alpymist-settings is where
# settings are changed. alpymist-screensaver decides when an idle machine shows
# a screensaver and when its screen goes off, and brings swayidle and wlopm with
# it; alpymist-saver-mountains and alpymist-saver-starfield are the screensavers
# Alpymist ships, and are named separately because they are packages like any
# other. alpymist-lock is what Super+L, the menu's Lock and a lid set to lock
# all run (ADR 0010). hyprland-plugins-hyprexpo is the overview Super+Tab
# opens, Alpine's build of Hyprland's own plugin and the one plugin
# hyprland-security.conf lets in (ADR 0015); binutils is for its `nm`, which
# Hyprland runs over itself to find the function a plugin hooks, and which
# nothing else here would bring. alpymist-overview is what the key shows
# where that plugin cannot load. alpymist-thunderbolt asks before a
# Thunderbolt or USB4 dock is let in. Hyprland's own wallpaper and idle daemons
# are not packaged for Alpine 3.24; swaybg and swayidle work under it.
# Thunar is the file manager, with gvfs for its trash and its list of drives
# and udisks2 to mount them: a stick is mounted when it is opened, never when
# it is plugged in, so thunar-volman is left out, and so is tumbler, whose
# thumbnails would have a parser read every picture, film and document in a
# folder that is only looked at (ADR 0028).
depends="
	7zip
	adwaita-icon-theme
	alpymist
	alpymist-about
	alpymist-ai-usage
	alpymist-auth
	alpymist-greeter
	alpymist-keys
	alpymist-lock
	alpymist-menu
	alpymist-overview
	alpymist-power
	alpymist-saver-mountains
	alpymist-saver-starfield
	alpymist-screensaver
	alpymist-settings
	alpymist-shell=$pkgver-r$pkgrel
	alpymist-tools=$pkgver-r$pkgrel
	alpymist-tui=$pkgver-r$pkgrel
	alpymist-splash-openrc
	alpymist-store
	alpymist-thunderbolt
	alpymist-wallpapers=$pkgver-r$pkgrel
	alpymist-wifi
	binutils
	bluetuith
	bluez
	breeze-cursors
	brightnessctl
	dbus
	flatpak
	font-dejavu
	font-fira-code-nerd
	font-fira-ttf
	font-nerd-fonts-symbols
	foot
	git-credential-libsecret
	gnome-keyring
	gnome-keyring-pam
	greetd
	grim
	gsettings-desktop-schemas
	gvfs
	hyprland
	hyprland-plugins-hyprexpo
	impala
	iwd
	librewolf
	mako
	mesa-dri-gallium
	mpv
	musl-locales
	pam-rundir
	pavucontrol
	pipewire
	pipewire-pulse
	pipewire-spa-bluez
	playerctl
	polkit
	ristretto
	seatd
	shadow
	slurp
	squint
	swaybg
	thunar
	thunar-archive-plugin
	udisks2
	waybar
	wireplumber
	wl-clipboard
	xarchiver
	xdg-desktop-portal
	xdg-desktop-portal-gtk
	xdg-desktop-portal-wlr
	xdg-user-dirs
	"
# The Wayland tools and the Full tier were subpackages once, beside labwc's Lite
# and Potato and i3's Legacy. Providing and replacing the two that were
# Hyprland's moves an upgrade from them to this package, world and all. Lite
# and Legacy are deliberately not provided: those installs stay on their last
# release, which their exact-version dependencies hold them to while everything
# else still upgrades (tried with apk 3.0.8 against local repositories).
provides="$pkgname-wayland=$pkgver-r$pkgrel $pkgname-full=$pkgver-r$pkgrel"
replaces="$pkgname-wayland $pkgname-full"
# What every program of the desktop group links, not this one alone: the
# first package of the group builds them all (ci/build-programs.sh).
makedepends="cargo libxkbcommon-dev linux-pam-dev"
subpackages="
	alpymist-shell:_shell
	alpymist-tools:_tools
	alpymist-tui:_tui
	alpymist-wallpapers:_wallpapers
	"
options="!check"  # the test suite runs in CI, not in the package build
install="$pkgname.post-install $pkgname.post-upgrade"
source=""
# The workspace: a copy of this package's own, or the one copy a dev build
# makes for all of them (ALPYMIST_WORKSPACE, from ci/build-packages.sh).
builddir="${ALPYMIST_WORKSPACE:-$srcdir}"

# Where cargo leaves what it builds. build-packages.sh points every package at
# one directory, and ci/build-programs.sh builds a whole group of programs
# into it at once, so the first package of a group builds them and the rest
# find it done.
_release="${CARGO_TARGET_DIR:-$srcdir/target}"/release

prepare() {
	# Already there, once for every package of this build.
	[ -z "${ALPYMIST_WORKSPACE:-}" ] || return 0
	# Same as alpymist: the workspace is bind-mounted at /src.
	tar -C /src -cf - \
		--exclude=./target \
		--exclude=./out \
		--exclude=./.git \
		. | tar -C "$builddir" -xf -
}

build() {
	sh "$builddir"/ci/build-programs.sh desktop
	# The wallpaper and the mark come from the same code: the furthest range in
	# the wallpaper is the mark, weathered.
	"$_release"/alpymist-wallpaper "$builddir"/alpymist.png 2560 1440
	"$_release"/alpymist-wallpaper --mark "$builddir"/mark.png 64
}

# Copy one of desktop/skel's parts into a package's /etc/skel: desktop into
# this package, shell into alpymist-shell.
_skel() {
	mkdir -p "$2"/etc/skel
	cp -a "$builddir"/desktop/skel/"$1"/. "$2"/etc/skel/
}

package() {
	# The drawn wallpaper. No longer the default, but still the one every
	# account made before the photographs points at.
	install -Dm644 "$builddir"/alpymist.png \
		"$pkgdir"/usr/share/backgrounds/alpymist/alpymist.png
	install -Dm644 "$builddir"/mark.png "$pkgdir"/usr/share/alpymist/mark.png
	# A PAM service of our own rather than an edit to greetd's, which belongs
	# to the greetd package; the desktop's greetd configuration names it.
	install -Dm644 "$builddir"/desktop/alpymist-greetd.pam \
		"$pkgdir"/etc/pam.d/alpymist-greetd
	install -Dm644 "$builddir"/desktop/alpymist-greeter.pam \
		"$pkgdir"/etc/pam.d/alpymist-greeter
	install -Dm644 "$builddir"/desktop/mimeapps.list "$pkgdir"/etc/xdg/mimeapps.list
	# A desktop started from a text console, where there is no PAM to make
	# XDG_RUNTIME_DIR; see the script.
	install -Dm644 "$builddir"/desktop/profile/alpymist-runtime-dir.sh \
		"$pkgdir"/etc/profile.d/alpymist-runtime-dir.sh
	# Why the desktop stopped, at the text console the login screen sends
	# people to when it does; see the script.
	install -Dm644 "$builddir"/desktop/profile/alpymist-session.sh \
		"$pkgdir"/etc/profile.d/alpymist-session.sh
	# Dark by default, for GTK 3, GTK 4, libadwaita and whatever asks the
	# portal. Defaults a user's own settings override; glib's trigger compiles
	# the schema override when this is installed.
	install -Dm644 "$builddir"/desktop/theme/90_alpymist.gschema.override \
		"$pkgdir"/usr/share/glib-2.0/schemas/90_alpymist.gschema.override
	install -Dm644 "$builddir"/desktop/theme/gtk-3.0-settings.ini \
		"$pkgdir"/etc/xdg/gtk-3.0/settings.ini
	install -Dm644 "$builddir"/desktop/theme/gtk-4.0-settings.ini \
		"$pkgdir"/etc/xdg/gtk-4.0/settings.ini
	# Folders as a list; see the file.
	install -Dm644 "$builddir"/desktop/thunar/thunar.xml \
		"$pkgdir"/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/thunar.xml
	# No strip of thumbnails nothing makes, and no message about it; see the
	# file.
	install -Dm644 "$builddir"/desktop/ristretto/ristretto.xml \
		"$pkgdir"/etc/xdg/xfce4/xfconf/xfce-perchannel-xml/ristretto.xml
	# impala and bluetuith among the menu's applications, under their own
	# names; neither brings a desktop entry. See _tui for the rest.
	local entry
	for entry in impala bluetuith; do
		install -Dm644 "$builddir"/desktop/tui/alpymist-$entry.desktop \
			"$pkgdir"/usr/share/applications/alpymist-$entry.desktop
	done
	# Who may mount a stick, and gvfs's root helper; see the file.
	install -Dm644 "$builddir"/desktop/polkit/49-alpymist-files.rules \
		"$pkgdir"/usr/share/polkit-1/rules.d/49-alpymist-files.rules
	install -Dm644 "$builddir"/desktop/librewolf/alpymist.js \
		"$pkgdir"/usr/lib/librewolf/defaults/pref/alpymist.js
	install -Dm644 "$builddir"/desktop/xdg-desktop-portal/portals.conf \
		"$pkgdir"/etc/xdg/xdg-desktop-portal/portals.conf
	# Flathub's remote, which each account adds for itself at login.
	install -Dm644 "$builddir"/desktop/flatpak/flathub.flatpakrepo \
		"$pkgdir"/usr/share/alpymist/flathub.flatpakrepo
	# Installs and removes Jottacloud's backup client, which is not a package;
	# the menu runs it.
	install -Dm755 "$builddir"/desktop/jottacloud/alpymist-jottacloud \
		"$pkgdir"/usr/bin/alpymist-jottacloud
	install -d "$pkgdir"/etc/alpymist
	# The bar itself, which each account's ~/.config/waybar includes, so an
	# upgrade reaches accounts made before it.
	local conf
	for conf in modules.jsonc hyprland.jsonc style.css; do
		install -Dm644 "$builddir"/desktop/waybar/$conf \
			"$pkgdir"/usr/share/alpymist/waybar/$conf
	done
	# git's HTTPS credentials go to the keyring; see the file. No package
	# owns /etc/gitconfig.
	install -Dm644 "$builddir"/desktop/git/gitconfig "$pkgdir"/etc/gitconfig
	# Keys go to the session's agent at first use; see the file.
	install -Dm644 "$builddir"/desktop/ssh/alpymist.conf \
		"$pkgdir"/etc/ssh/ssh_config.d/alpymist.conf
	install -Dm644 "$builddir"/desktop/xdg-desktop-portal/hyprland-portals.conf \
		"$pkgdir"/etc/xdg/xdg-desktop-portal/hyprland-portals.conf
	# What greetd starts, named by /etc/conf.d/greetd, which the installer
	# writes and the post-upgrade script moves on from alpymist-full.toml.
	install -Dm644 "$builddir"/desktop/greetd/alpymist.toml \
		"$pkgdir"/etc/greetd/alpymist.toml
	# hyprland.conf sources /etc/alpymist/hyprland-keyboard.conf, and the
	# installer writes the chosen layout there. The package ships only the US
	# default, which its install scripts copy into /etc where there is no file
	# yet. A file of the package's own in /etc would be one the installer had
	# changed, and every upgrade would leave a .apk-new beside it.
	install -Dm644 "$builddir"/desktop/hypr/hyprland-keyboard.conf \
		"$pkgdir"/usr/share/alpymist/hyprland-keyboard.conf
	# Permissions and Ctrl+Alt+Delete, which hyprland.conf sources; see the
	# file.
	install -Dm644 "$builddir"/desktop/hypr/hyprland-security.conf \
		"$pkgdir"/usr/share/alpymist/hyprland-security.conf
	# A dock's sound after the laptop's own when no device is chosen; see the
	# file. Its own name, beside WirePlumber's files, so no package's clashes.
	install -Dm644 "$builddir"/desktop/wireplumber/alpymist-docks.conf \
		"$pkgdir"/usr/share/wireplumber/wireplumber.conf.d/alpymist-docks.conf
	# What Hyprland asks its questions through, so that asking does not end
	# it; see the file. If Alpine comes to package hyprland-guiutils, its
	# hyprland-dialog and this one are the same path, and this one goes.
	install -Dm755 "$builddir"/desktop/hypr/hyprland-dialog \
		"$pkgdir"/usr/bin/hyprland-dialog
	# Which windows float as dialogs, which hyprland-security.conf sources.
	install -Dm644 "$builddir"/desktop/hypr/hyprland-windows.conf \
		"$pkgdir"/usr/share/alpymist/hyprland-windows.conf
	# The volume, brightness, media and radio keys, which
	# hyprland-security.conf sources too.
	install -Dm644 "$builddir"/desktop/hypr/hyprland-keys.conf \
		"$pkgdir"/usr/share/alpymist/hyprland-keys.conf
	# The screen's and the keyboard's light, to the video group; see the file.
	install -Dm644 "$builddir"/desktop/udev/91-alpymist-backlight.rules \
		"$pkgdir"/usr/lib/udev/rules.d/91-alpymist-backlight.rules
	_skel desktop "$pkgdir"
}

# What a developer reaches for in the first ten minutes, so it is there
# without a trip to the store: git and an SSH client (the SSH server stays a
# switch in Settings, off until turned on), nano, which hyprland.conf leaves as
# the editor outside the desktop, curl and rsync, less and unzip beyond what
# busybox's do, man with the pages to read, and GitHub's command line; and
# each of their own manuals, so `man git` answers (Alpine keeps a program's
# manual in its -doc package, and `docs`, which pulls in every one, is some
# 300 MiB). None of them is pinned: apk takes each from Alpine's repositories
# at whatever version Alpine has. The desktop depends on it, and the installer
# adds it without one too.
_tools() {
	pkgdesc="Alpymist tools: git, ssh, nano, curl, rsync, man and gh"
	depends="
		curl
		curl-doc
		git
		git-doc
		github-cli
		github-cli-doc
		less
		less-doc
		man-pages
		mandoc
		mandoc-doc
		nano
		nano-doc
		openssh-client
		openssh-doc
		rsync
		rsync-doc
		unzip
		unzip-doc
		"
	mkdir -p "$subpkgdir"
}

# A terminal's programs, for whoever lives in one: lazygit for a repository,
# cliamp for music and the radio, btop for what the machine is doing, ncdu
# for what fills the disk, tmux, fastfetch to say what the machine is, and
# tty-solitaire, a game of cards in 65 KiB.
# About 64 MiB, most of it lazygit and cliamp, each one Go binary. The
# desktop depends on it, as it does on the tools, so an upgrade brings them
# to a system that was installed before they were. cliamp plays
# through ALSA, which pipewire-alsa hands to PipeWire, and asks ffmpeg for
# the radio stations that send AAC; mpv's libraries are most of ffmpeg
# already. None of them is pinned but cliamp, which is our own aport of a
# release Alpine does not package (ADR 0029).
_tui() {
	pkgdesc="Alpymist terminal programs: lazygit, cliamp, btop, ncdu, tmux, fastfetch and a card game"
	depends="
		btop
		cliamp
		fastfetch
		ffmpeg
		lazygit
		ncdu
		pipewire-alsa
		tmux
		tty-solitaire
		"
	mkdir -p "$subpkgdir"
	# The menu lists what has a desktop entry. btop and cliamp bring their
	# own; these four have none, in Alpine or upstream. Named as ours, so
	# that one of Alpine's arriving later is a second line in the menu and
	# not two packages owning a file.
	local entry
	for entry in lazygit ncdu tmux ttysolitaire; do
		install -Dm644 "$builddir"/desktop/tui/alpymist-$entry.desktop \
			"$subpkgdir"/usr/share/applications/alpymist-$entry.desktop
	done
}

# The photographs: the default wallpaper is one of them, and the rest
# sit beside it for whoever wants another. All 16:9 at 1920x1080, so each
# desktop's fill mode crops a little off a 16:10 or 4:3 screen and nothing is
# stretched. See brand/wallpapers/README.md.
_wallpapers() {
	pkgdesc="Alpymist wallpapers: mountain photographs and paintings"
	depends=""
	local picture
	for picture in "$builddir"/brand/wallpapers/*.jpg; do
		install -Dm644 "$picture" \
			"$subpkgdir"/usr/share/backgrounds/alpymist/"${picture##*/}"
	done
}

# zsh with oh-my-zsh, the two plugins most people add first, and starship. In
# the image's world rather than the desktop's, because adduser makes zsh the
# login shell: it must be installed even if the desktop is not.
_shell() {
	pkgdesc="Alpymist shell: zsh, oh-my-zsh and starship"
	depends="
		oh-my-zsh
		starship
		zsh
		zsh-autosuggestions
		zsh-completions
		zsh-syntax-highlighting
		"
	_skel shell "$subpkgdir"
}
