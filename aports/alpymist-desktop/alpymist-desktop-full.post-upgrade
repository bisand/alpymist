#!/bin/sh
# Hyprland's keyboard layout: the US default, where the installer or the user
# has not already written one. See _full in the APKBUILD for why the file in
# /etc is not the package's own.
conf=/etc/alpymist/hyprland-keyboard.conf
if [ ! -e "$conf" ]; then
	mkdir -p /etc/alpymist
	cp /usr/share/alpymist/hyprland-keyboard.conf "$conf"
fi

# Ghostty is no longer part of the Full tier, and this upgrade removes it. Each
# account's hyprland.conf is its own and is not changed here, so say which ones
# still start it on Super+Return and Super+Q.
for home in /root /home/*; do
	hypr="$home/.config/hypr/hyprland.conf"
	if [ -f "$hypr" ] && grep -Eq '^\$terminal *= *ghostty' "$hypr"; then
		echo "  * $hypr starts ghostty, which is no longer installed."
		echo "    Change its \$terminal line to: \$terminal = foot"
	fi
done
exit 0
