#!/bin/sh
# Hyprland's keyboard layout: the US default, where the installer or the user
# has not already written one. See package() in the APKBUILD for why the file in
# /etc is not the package's own.
conf=/etc/alpymist/hyprland-keyboard.conf
if [ ! -e "$conf" ]; then
	mkdir -p /etc/alpymist
	cp /usr/share/alpymist/hyprland-keyboard.conf "$conf"
fi
# Hyprland sources ~/.config/alpymist/hypr/settings.conf and refuses a missing
# one. `alpymist session hyprland` writes it at login; for accounts already
# logged in, whose Hyprland reloads when this package's files change, write it
# now, as each account.
if command -v alpymist >/dev/null 2>&1; then
	for home in /home/*; do
		[ -d "$home/.config/hypr" ] || continue
		owner=$(stat -c %U "$home" 2>/dev/null) || continue
		[ "$owner" = root ] && continue
		su -s /bin/sh "$owner" -c "alpymist session prepare" >/dev/null 2>&1 || true
	done
fi
# The clock set from the network, as the installer also does: busybox's ntpd, a
# client only. Not started here, where apk may be installing into a disk being
# set up and the running system is someone else's. The mark says it has been
# turned on once, so no upgrade turns it on again after Settings turned it off.
rc-update add ntpd default >/dev/null 2>&1 || true
mkdir -p /var/lib/alpymist
: >/var/lib/alpymist/network-time
exit 0
