# Contributor: André Biseth <andre@biseth.net>
# Maintainer: André Biseth <andre@biseth.net>
pkgname=alpymist-settings
pkgver=0.3.8
pkgrel=0
pkgdesc="Alpymist Settings: every setting in one window, searched by keyboard"
url="https://github.com/bisand/alpymist"
arch="all"
license="MIT OR Apache-2.0"
# The window is an xdg toplevel over wl_shm, drawn with Denise's widgets on
# the CPU, which needs libxkbcommon and the menu's fonts. Settings are read and
# changed through the same library as `alpymist`; a system setting runs
# `alpymist set` through alpymist-auth's password dialog and polkit. The menu
# finds every setting through the fragment generated here from the registry,
# so its entries are always the installed window's (ADR 0007).
# What every program of the desktop group links, not this one alone: the
# first package of the group builds them all (ci/build-programs.sh).
makedepends="cargo libxkbcommon-dev linux-pam-dev"
depends="alpymist alpymist-auth font-fira-ttf font-nerd-fonts-symbols polkit wl-clipboard"
options="!check"  # the test suite runs in CI, not in the package build
source=""
# The workspace: a copy of this package's own, or the one copy a dev build
# makes for all of them (ALPYMIST_WORKSPACE, from ci/build-packages.sh).
builddir="${ALPYMIST_WORKSPACE:-$srcdir}"

# Where cargo leaves what it builds. build-packages.sh points every package at
# one directory, and ci/build-programs.sh builds a whole group of programs
# into it at once, so the first package of a group builds them and the rest
# find it done.
_release="${CARGO_TARGET_DIR:-$srcdir/target}"/release

prepare() {
	# Already there, once for every package of this build.
	[ -z "${ALPYMIST_WORKSPACE:-}" ] || return 0
	# Same as alpymist: the workspace is bind-mounted at /src.
	tar -C /src -cf - \
		--exclude=./target \
		--exclude=./out \
		--exclude=./.git \
		. | tar -C "$builddir" -xf -
}

build() {
	cd "$builddir"
	sh "$builddir"/ci/build-programs.sh desktop
	"$_release"/alpymist menu-fragment > settings.toml
}

package() {
	install -Dm755 "$_release"/alpymist-settings \
		"$pkgdir"/usr/bin/alpymist-settings
	install -Dm644 "$builddir"/settings.toml \
		"$pkgdir"/usr/share/alpymist/menu.d/settings.toml
	install -Dm644 "$builddir"/desktop/settings/alpymist-settings.desktop \
		"$pkgdir"/usr/share/applications/alpymist-settings.desktop
}

# Filled in by `abuild checksum` at build time; see alpymist-install.
sha512sums=""
