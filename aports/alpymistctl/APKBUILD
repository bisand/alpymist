# Maintainer: André Biseth <andre@biseth.net>
#
# alpymistctl is alpymist now (ADR 0007). This package is only the old name, a
# link to the new command, so systems that have alpymistctl in their world move
# to alpymist on upgrade and anything still calling alpymistctl keeps working.
# It goes after one release.
pkgname=alpymistctl
pkgver=0.0.1
pkgrel=2
pkgdesc="Transitional: alpymistctl is now alpymist"
url="https://github.com/bisand/alpymist"
arch="noarch"
license="MIT OR Apache-2.0"
depends="alpymist"
options="!check"  # nothing to test
source=""
builddir="$srcdir"

package() {
	mkdir -p "$pkgdir"/usr/bin
	ln -s alpymist "$pkgdir"/usr/bin/alpymistctl
}
