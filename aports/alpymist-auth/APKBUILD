# Contributor: André Biseth <andre@biseth.net>
# Maintainer: André Biseth <andre@biseth.net>
pkgname=alpymist-auth
pkgver=0.3.5
pkgrel=0
pkgdesc="Alpymist's password prompt: polkit authentication and SSH passphrases in a Denise dialog"
url="https://github.com/bisand/alpymist"
arch="all"
license="MIT OR Apache-2.0"
# A polkit agent for one process at a time, which is what polkit allows
# without elogind; the password is checked by polkit's own setuid helper, not
# by anything here. polkitd is spoken to over the system bus, which needs
# nothing linked. The dialog is a layer surface drawn by Denise on the CPU, so
# it needs libxkbcommon and the menu's fonts. The same dialog is ssh's
# SSH_ASKPASS, run by the name linked in /usr/libexec, since ssh gives the
# program it runs nothing but the question.
makedepends="cargo libxkbcommon-dev"
depends="polkit font-fira-ttf font-nerd-fonts-symbols"
options="!check"  # the test suite runs in CI, not in the package build
source=""
# The workspace: a copy of this package's own, or the one copy a dev build
# makes for all of them (ALPYMIST_WORKSPACE, from ci/build-packages.sh).
builddir="${ALPYMIST_WORKSPACE:-$srcdir}"

# Where cargo leaves what it builds. build-packages.sh points every package at
# one directory, so a dependency compiled for one is not compiled again for the
# next; each still builds only its own crates with their own features.
_release="${CARGO_TARGET_DIR:-$srcdir/target}"/release

prepare() {
	# Already there, once for every package of this build.
	[ -z "${ALPYMIST_WORKSPACE:-}" ] || return 0
	# Same as alpymist: the workspace is bind-mounted at /src.
	tar -C /src -cf - \
		--exclude=./target \
		--exclude=./out \
		--exclude=./.git \
		. | tar -C "$builddir" -xf -
}

build() {
	cd "$builddir"
	cargo build --release --locked -p alpymist-auth
}

package() {
	install -Dm755 "$_release"/alpymist-auth \
		"$pkgdir"/usr/bin/alpymist-auth
	mkdir -p "$pkgdir"/usr/libexec
	ln -s ../bin/alpymist-auth "$pkgdir"/usr/libexec/alpymist-askpass
}
