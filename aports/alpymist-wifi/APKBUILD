# Contributor: André Biseth <andre@biseth.net>
# Maintainer: André Biseth <andre@biseth.net>
pkgname=alpymist-wifi
pkgver=0.2.0
pkgrel=0
pkgdesc="Alpymist Wi-Fi: iwd from a popup under the bar, the bar's Wi-Fi icon, and a command line"
url="https://github.com/bisand/alpymist"
arch="all"
license="MIT OR Apache-2.0"
# iwd is driven over the system bus, which needs nothing linked: zbus speaks
# the protocol itself. The popup is the menu's host — wlr-layer-shell over
# wl_shm, drawn by Denise on the CPU — so it needs libxkbcommon and the same
# fonts, and falls back to Denise's bitmap without them.
makedepends="cargo libxkbcommon-dev"
depends="dbus iwd font-fira-ttf font-nerd-fonts-symbols"
options="!check"  # the test suite runs in CI, not in the package build
source=""
builddir="$srcdir"

prepare() {
	# Same as alpymist: the workspace is bind-mounted at /src.
	tar -C /src -cf - \
		--exclude=./target \
		--exclude=./out \
		--exclude=./.git \
		. | tar -C "$builddir" -xf -
}

build() {
	cd "$builddir"
	cargo build --release --locked -p alpymist-wifi
}

package() {
	install -Dm755 "$builddir"/target/release/alpymist-wifi \
		"$pkgdir"/usr/bin/alpymist-wifi
}
