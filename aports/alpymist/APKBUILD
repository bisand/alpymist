# Contributor: André Biseth <andre@biseth.net>
# Maintainer: André Biseth <andre@biseth.net>
pkgname=alpymist
pkgver=0.5.0
pkgrel=0
pkgdesc="Alpymist's command line: settings, the release channel and the hardware probe"
url="https://github.com/bisand/alpymist"
arch="all"
license="MIT OR Apache-2.0"
# This was alpymistctl, and a system that added it by that name still has
# alpymistctl in its world. Providing the name, with a version, is what lets
# apk take this package for it and purge the old one with its link; without
# it the stale package stays installed for good. Keep it while such systems
# may still be upgrading.
provides="alpymistctl=$pkgver-r$pkgrel"
# What every program of the desktop group links, not this one alone: the
# first package of the group builds them all (ci/build-programs.sh).
makedepends="cargo libxkbcommon-dev linux-pam-dev"
# libEGL is loaded at runtime, not linked, so it is deliberately not a depend:
# alpymist must work on a system with no Mesa and simply report less.
# alpymist-firmware, in the -openrc package, installs firmware that a driver
# asks for after installation; see its init script.
subpackages="$pkgname-openrc"
options="!check"  # the test suite runs in CI, not in the package build
install="$pkgname-openrc.post-install"
source="alpymist-firmware.initd"
# The workspace: a copy of this package's own, or the one copy a dev build
# makes for all of them (ALPYMIST_WORKSPACE, from ci/build-packages.sh).
builddir="${ALPYMIST_WORKSPACE:-$srcdir}"

# Where cargo leaves what it builds. build-packages.sh points every package at
# one directory, and ci/build-programs.sh builds a whole group of programs
# into it at once, so the first package of a group builds them and the rest
# find it done.
_release="${CARGO_TARGET_DIR:-$srcdir/target}"/release

prepare() {
	# Already there, once for every package of this build.
	[ -z "${ALPYMIST_WORKSPACE:-}" ] || return 0
	# The workspace is bind-mounted at /src by the builder container. Copy the
	# whole tree rather than a list of members: cargo needs every workspace
	# member's manifest to resolve, and a hand-maintained list silently breaks
	# the build the next time a crate is added.
	tar -C /src -cf - \
		--exclude=./target \
		--exclude=./out \
		--exclude=./.git \
		. | tar -C "$builddir" -xf -
}

build() {
	cd "$builddir"
	sh "$builddir"/ci/build-programs.sh desktop
}

package() {
	install -Dm755 "$_release"/alpymist \
		"$pkgdir"/usr/bin/alpymist
	# System settings run `alpymist set` through pkexec; what that asks.
	install -Dm644 "$builddir"/desktop/polkit/org.alpymist.settings.policy \
		"$pkgdir"/usr/share/polkit-1/actions/org.alpymist.settings.policy
	install -Dm755 "$srcdir"/alpymist-firmware.initd \
		"$pkgdir"/etc/init.d/alpymist-firmware
	# Tab after `alpymist`, for each shell in the place it looks. Here and
	# not in packages of their own: they are a few lines that ask the
	# program above what to offer, and zsh is every account's shell.
	install -Dm644 "$builddir"/desktop/completion/_alpymist \
		"$pkgdir"/usr/share/zsh/site-functions/_alpymist
	install -Dm644 "$builddir"/desktop/completion/alpymist.bash \
		"$pkgdir"/usr/share/bash-completion/completions/alpymist
	install -Dm644 "$builddir"/desktop/completion/alpymist.fish \
		"$pkgdir"/usr/share/fish/vendor_completions.d/alpymist.fish
}

# Filled in by `abuild checksum` at build time; see alpymist-install.
sha512sums=""
