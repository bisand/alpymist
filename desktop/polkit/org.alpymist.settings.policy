<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Alpymist settings: what changing a system setting asks.

  `alpymist set` runs itself again through pkexec for a system setting (the
  keyboard layout, the release channel), and pkexec picks the action by the
  path and the first argument. Run that way it writes system settings only,
  checks the value against the setting first, and pkexec has cleared the
  environment. auth_admin_keep: an administrator's password, kept a few
  minutes so Settings can change several in a row. There is no elogind, so
  allow_any is the setting that applies.
-->
<policyconfig>
  <vendor>Alpymist</vendor>
  <vendor_url>https://github.com/bisand/alpymist</vendor_url>

  <action id="org.alpymist.settings.set">
    <description>Change a system setting</description>
    <message>Authentication is needed to change a setting for everyone on this computer</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/alpymist</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set</annotate>
  </action>

  <action id="org.alpymist.settings.reset">
    <description>Reset a system setting</description>
    <message>Authentication is needed to reset a setting for everyone on this computer</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/alpymist</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">reset</annotate>
  </action>

  <action id="org.alpymist.settings.channel">
    <description>Change the release channel</description>
    <message>Authentication is needed to change which Alpymist packages this computer upgrades to</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/alpymist</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">channel</annotate>
  </action>
</policyconfig>
