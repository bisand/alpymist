<?xml version="1.0" encoding="UTF-8"?>
<!--
  Alpymist: how Thunar starts out, until you choose otherwise in its own
  Edit › Preferences and View menu, which write
  ~/.config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml; that file overrides
  this one, setting by setting.

  Folders open as a list, with sizes and dates. The path is a row of
  folders to click, not a line of text; Ctrl+L still gives the line. And
  the menu bar is one button at the start of the toolbar, as Alpymist's own
  windows have no bar of menus; Ctrl+M brings it back.
-->
<channel name="thunar" version="1.0">
  <property name="default-view" type="string" value="ThunarDetailsView"/>
  <property name="last-location-bar" type="string" value="ThunarLocationButtons"/>
  <property name="last-menubar-visible" type="bool" value="false"/>
</channel>
