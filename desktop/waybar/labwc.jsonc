// Alpymist: the top bar under labwc.
//
// Belongs to the alpymist-desktop-wayland package and is replaced on every
// upgrade: change ~/.config/waybar/labwc.jsonc instead, which includes this.
// The modules shared with the other desktop are in modules.jsonc.
//
// The clock comes first, so it wins over modules.jsonc's: Settings writes it,
// 24-hour or 12-hour, and until then there is none and modules.jsonc's stands.
{
  "include": [
    "/etc/alpymist/waybar/clock.jsonc",
    "/usr/share/alpymist/waybar/modules.jsonc"
  ],

  "modules-left": ["custom/alpymist", "wlr/taskbar"],

  "custom/alpymist": {
    // The mark is an image, drawn by our own code; see the stylesheet.
    "format": " ",
    "tooltip-format": "Applications",
    "on-click": "fuzzel"
  },

  "custom/session": {
    "format": "󰐥",
    "tooltip-format": "Session",
    "on-click": "sh -c 'case $(printf \"Lock\\nLog out\\nRestart\\nShut down\" | fuzzel --dmenu --lines 4) in Lock) alpymist-lock;; \"Log out\") labwc --exit;; Restart) doas reboot;; \"Shut down\") doas poweroff;; esac'"
  }
}
