# Alpymist, Legacy tier: let Xorg.wrap start the X server with root rights.
#
# Without elogind nothing gives the logged-in user the virtual terminal, so an
# unprivileged Xorg fails with "Cannot open virtual console". This is the
# traditional answer on systems without logind. Xorg.wrap still only does it
# for a user logged in on a console (allowed_users defaults to console).
#
# The cost is an X server running as root, on this tier only; the Wayland
# tiers run their compositors unprivileged through seatd.
needs_root_rights = yes
