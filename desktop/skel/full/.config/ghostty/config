# Alpymist: Ghostty, the terminal on the Full tier.
#
# Yours to change: the installer copied this into your home. The other tiers
# use foot, which is faster where there is no GPU to draw with.

font-family = Fira Mono
font-size = 11

window-padding-x = 10
window-padding-y = 8
window-decoration = false
confirm-close-surface = false

# The installer's palette.
background = 0b121e
foreground = eaf0f6
cursor-color = 7fb8d9
selection-background = 3a4c63
selection-foreground = eaf0f6

palette = 0=#070c14
