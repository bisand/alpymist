// Alpymist: the top bar under labwc.
//
// Slim, solid and icon-led: the desktop is the wallpaper, not the bar. Details
// live in tooltips rather than on screen, and every icon comes from the Nerd
// Font symbols, with Fira Mono for text.
{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 0,

  "modules-left": ["custom/alpymist", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["group/tray-drawer", "bluetooth", "network", "pulseaudio", "cpu", "memory", "battery", "custom/session"],

  "custom/alpymist": {
    // The mark is an image, drawn by our own code; see the stylesheet.
    "format": " ",
    "tooltip-format": "Applications",
    "on-click": "fuzzel"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": { "*": 5 }
  },

  "clock": {
    "format": "{:%a %H:%M}",
    "format-alt": "{:%A %d %B %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  "group/tray-drawer": {
    "orientation": "inherit",
    "drawer": { "transition-duration": 300, "children-class": "tray-item", "transition-left-to-right": false },
    "modules": ["custom/tray-arrow", "tray"]
  },
  "custom/tray-arrow": { "format": "󰅁", "tooltip-format": "Background applications" },
  "tray": { "spacing": 10 },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-disabled": "",
    "format-off": "",
    "format-no-controller": "",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-connected": "{device_enumerate}"
  },

  "network": {
    "interval": 5,
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "No network"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "tooltip-format": "{desc}  {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  "cpu": { "interval": 5, "format": "󰍛", "tooltip-format": "Processor  {usage}%" },
  "memory": { "interval": 10, "format": "󰘚", "tooltip-format": "Memory  {percentage}%  ({used:0.1f}G of {total:0.1f}G)" },

  "battery": {
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "Battery {capacity}%  {timeTo}",
    "states": { "warning": 20, "critical": 10 }
  },

  "custom/session": {
    "format": "󰐥",
    "tooltip-format": "Session",
    "on-click": "sh -c 'case $(printf \"Lock\\nLog out\\nRestart\\nShut down\" | fuzzel --dmenu --lines 4) in Lock) swaylock -f -c 0b121e;; \"Log out\") hyprctl dispatch exit;; Restart) doas reboot;; \"Shut down\") doas poweroff;; esac'"
  }
}
