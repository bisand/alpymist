// Your top bar under labwc.
//
// Alpymist's bar is included from /usr/share/alpymist/waybar/labwc.jsonc,
// which upgrades keep current. Anything set here wins over it, a setting at a
// time: add only what you want different, and the rest still follows
// Alpymist. For example, the clock with the date:
//
//   "clock": { "format": "{:%a %d %b %H:%M}" },
//
// or a bar without the processor and memory icons (a list replaces
// Alpymist's whole list):
//
//   "modules-right": ["group/tray-drawer", "bluetooth", "custom/wifi",
//                     "network", "pulseaudio", "custom/battery", "custom/session"],
//
// Save, then log out and in again to restart the bar.
{
  "include": ["/usr/share/alpymist/waybar/labwc.jsonc"]
}
