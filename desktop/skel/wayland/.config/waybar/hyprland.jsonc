// Alpymist: the top bar under Hyprland.
//
// Slim, solid and icon-led: the desktop is the wallpaper, not the bar. Details
// live in tooltips rather than on screen, and every icon comes from the Nerd
// Font symbols, with Fira Mono for text.
{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 0,

  "modules-left": ["custom/alpymist", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["group/tray-drawer", "bluetooth", "custom/wifi", "network", "pulseaudio", "cpu", "memory", "battery", "custom/session"],

  "custom/alpymist": {
    // The mark is an image, drawn by our own code; see the stylesheet.
    "format": " ",
    "tooltip-format": "Menu",
    "on-click": "alpymist-menu"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": { "*": 5 }
  },

  "clock": {
    "format": "{:%a %H:%M}",
    "format-alt": "{:%A %d %B %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },

  "group/tray-drawer": {
    "orientation": "inherit",
    "drawer": { "transition-duration": 300, "children-class": "tray-item", "transition-left-to-right": false },
    "modules": ["custom/tray-arrow", "tray"]
  },
  "custom/tray-arrow": { "format": "󰅁", "tooltip-format": "Background applications" },
  "tray": { "spacing": 10 },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-disabled": "",
    "format-off": "",
    "format-no-controller": "",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-connected": "{device_enumerate}"
  },

  // Wi-Fi is alpymist-wifi: it prints the icon and tooltip whenever iwd
  // changes anything, and a click opens its popup under the bar; a second
  // click closes it. Without a Wi-Fi adapter it prints nothing and Waybar
  // hides it.
  "custom/wifi": {
    "exec": "alpymist-wifi --waybar",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "alpymist-wifi"
  },

  // The wired port only: an empty format hides the module on Wi-Fi, and when
  // nothing is plugged in, which custom/wifi already says.
  "network": {
    "interval": 5,
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "tooltip-format": "{desc}  {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  "cpu": { "interval": 5, "format": "󰍛", "tooltip-format": "Processor  {usage}%" },
  "memory": { "interval": 10, "format": "󰘚", "tooltip-format": "Memory  {percentage}%  ({used:0.1f}G of {total:0.1f}G)" },

  "battery": {
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "Battery {capacity}%  {timeTo}",
    "states": { "warning": 20, "critical": 10 }
  },

  "custom/session": {
    "format": "󰐥",
    "tooltip-format": "Session",
    "on-click": "alpymist-menu system"
  }
}
