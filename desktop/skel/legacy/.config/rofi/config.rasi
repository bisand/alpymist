/* Alpymist: the launcher on the X11 desktop. */
configuration {
  font: "Fira Mono 11";
  show-icons: false;
  terminal: "xterm";
  display-drun: "›";
}

/* Start from nothing, so none of rofi's default theme shows through. */
@theme "/dev/null"

* {
  background-color: transparent;
  text-color: #eaf0f6;
  border-color: #7fb8d9;
}

window {
  width: 40%;
  background-color: #0b121e;
  border: 2px;
  border-radius: 8px;
  padding: 12px;
}

mainbox { children: [ inputbar, listview ]; spacing: 10px; }
inputbar { children: [ prompt, entry ]; spacing: 8px; padding: 6px 8px; }
prompt { text-color: #7fb8d9; }
entry { placeholder: "Search"; placeholder-color: #9aabbd; }
listview { lines: 10; scrollbar: false; }
element { padding: 5px 8px; border-radius: 4px; }
element selected { background-color: #3a4c63; }
element-text { text-color: inherit; }
