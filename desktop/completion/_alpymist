#compdef alpymist

# Tab after `alpymist` in zsh. What is offered is `alpymist complete`'s to
# say (crates/alpymist/src/complete.rs): a value on each line, then a tab and
# what it is. It ends with 3 when the word is a file's name.

local -a lines described
local line

lines=("${(@f)$(alpymist complete -- "${(@)words[2,CURRENT]}" 2>/dev/null)}")
if (( $? == 3 )); then
    _files
    return
fi
for line in $lines; do
    if [[ $line == *$'\t'* ]]; then
        described+=("${${line%%$'\t'*}//:/\\:}:${line#*$'\t'}")
    else
        described+=("${line//:/\\:}")
    fi
done
# -V: in the order given, which for a setting's values means something.
_describe -V value described
